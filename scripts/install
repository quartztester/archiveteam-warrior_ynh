#!/bin/bash
source /usr/share/yunohost/helpers


if [ "${path:-/}" != "/" ]; then
    ynh_die --message="The Warrior dashboard uses absolute URLs and only works at the root of a domain — pick a (sub)domain with path '/'."
fi

if ! systemctl is-active --quiet docker; then
    # Bootstrap Docker when absent (fresh server / CI container); skip when
    # any daemon is already present (docker.io or docker-ce — never force
    # one over the other, the packages conflict).
    if ! command -v docker >/dev/null 2>&1; then
        ynh_script_progression "Installing Docker (docker.io)..."
        apt-get update -qq
        DEBIAN_FRONTEND=noninteractive apt-get -y --no-install-recommends install docker.io
    fi
    systemctl enable --now docker
    for _ in $(seq 1 30); do docker info >/dev/null 2>&1 && break; sleep 2; done
    docker info >/dev/null 2>&1 || ynh_die --message="Docker installed but the daemon did not come up."
fi

if ! docker compose version >/dev/null 2>&1; then
    ynh_script_progression "Installing docker compose v2 CLI plugin..."
    mkdir -p /usr/local/lib/docker/cli-plugins
    ynh_setup_source --source_id=compose --dest_dir="/usr/local/lib/docker/cli-plugins"
    # the asset may land under its URL basename or the source-id name
    # depending on prefetch naming — handle both.
    if [ -e "/usr/local/lib/docker/cli-plugins/docker-compose-linux-x86_64" ]; then
        mv "/usr/local/lib/docker/cli-plugins/docker-compose-linux-x86_64" /usr/local/lib/docker/cli-plugins/compose
    fi
    chmod 755 /usr/local/lib/docker/cli-plugins/compose
fi

# Leaderboard nickname = first YunoHost admin's fullname (fallback: username, then 'warrior'); stored as a setting so upgrades can reuse it.
ynh_script_progression "Deriving leaderboard nickname from the YunoHost admin account..."
nickname=$(yunohost user group info admins --output-as json 2>/dev/null | python3 -c '
import json, re, subprocess, sys
try:
    members = json.load(sys.stdin).get("members") or []
except Exception:
    members = []
user = members[0] if members else ""
if user:
    try:
        out = subprocess.run(["yunohost", "user", "info", user, "--output-as", "json"],
                             capture_output=True, text=True).stdout
        user = json.loads(out).get("fullname") or user
    except Exception:
        pass
user = re.sub(r"[^\w .\-]", "", user or "", flags=re.UNICODE).strip()
print(user or "warrior")')
ynh_app_setting_set --key=nickname --value="$nickname"
ynh_print_info "Leaderboard nickname: $nickname"

# No firewall rules: the warrior is outbound-only, dashboard on loopback.

ynh_script_progression "Writing compose config (nickname: $nickname)..."
ynh_config_add --template="docker-compose.yml" --destination="$install_dir/docker-compose.yml"
# Container's 'warrior' user is uid/gid 1000 — bind mounts must be writable by it
mkdir -p "$install_dir/data" "$install_dir/projects"
# The image's HEALTHCHECK and downloader expect wget-at* inside /data; an empty bind mount would shadow the image's files.
seed=$(docker create --entrypoint sh atdr.meo.ws/archiveteam/warrior-dockerfile:latest)
for f in wget-at wget-at-gnutls wget-at-nss wget-at-openssl; do
    docker cp "$seed:/home/warrior/data/$f" "$install_dir/data/$f" 2>/dev/null || true
done
docker rm "$seed" >/dev/null 2>&1 || true
chown -R 1000:1000 "$install_dir/data" "$install_dir/projects"

ynh_script_progression "Pulling Warrior image..."
docker compose -f "$install_dir/docker-compose.yml" pull

ynh_script_progression "Configuring systemd service..."
ynh_config_add_systemd
ynh_systemctl --service="$app" --action=start --log_path=systemd --timeout=300

ynh_script_progression "Configuring nginx (SSO-gated)..."
ynh_config_add_nginx

# $app.png in the applogos dir is the supported logo override; the permission update pins the hash so the portal serves it.
if [ -f "$YNH_APP_BASEDIR/doc/archiveteam-warrior.png" ]; then
    cp "$YNH_APP_BASEDIR/doc/archiveteam-warrior.png" "/usr/share/yunohost/applogos/$app.png"
    yunohost user permission update "$app.main" --logo "/usr/share/yunohost/applogos/$app.png" || true
fi

ynh_script_progression "Giving the warrior 15s to boot..."
sleep 15
# A fresh warrior with empty selected_project sits idle forever (tracker sends
# 'auto' only when asked) — select 'auto' (ArchiveTeam's weighted choice).
curl -s --max-time 5 -X POST "http://127.0.0.1:${port}/api/select-project" -d 'project_name=auto' >/dev/null 2>&1 || true
if curl -s -o /dev/null --max-time 5 "http://127.0.0.1:${port}/"; then
    ynh_print_warn "Warrior dashboard: https://$domain$path (SSO-gated). Also on loopback: http://127.0.0.1:${port}"
else
    ynh_print_warn "Dashboard not answering yet — check: docker logs $app"
fi

ynh_script_progression "ArchiveTeam Warrior installed. No router port-forward needed (outbound-only)."

#!/bin/bash
source /usr/share/yunohost/helpers


ynh_script_progression "Re-rendering compose config and systemd unit..."
ynh_safe_rm "$install_dir/docker-compose.yml"
ynh_config_add --template="docker-compose.yml" --destination="$install_dir/docker-compose.yml"
ynh_safe_rm "/etc/systemd/system/$app.service"
ynh_config_add_systemd

ynh_script_progression "Re-rendering nginx config..."
ynh_safe_rm "/etc/nginx/conf.d/$domain.d/$app.conf"
ynh_config_add_nginx

# Re-seed wget binaries if missing (installs predating this fix)
if [ ! -f "$install_dir/data/wget-at-gnutls" ]; then
    seed=$(docker create --entrypoint sh atdr.meo.ws/archiveteam/warrior-dockerfile:latest)
    for f in wget-at wget-at-gnutls wget-at-nss wget-at-openssl; do
        docker cp "$seed:/home/warrior/data/$f" "$install_dir/data/$f" 2>/dev/null || true
    done
    docker rm "$seed" >/dev/null 2>&1 || true
fi
chown -R 1000:1000 "$install_dir/data" "$install_dir/projects"

# Refresh the SSO tile logo if shipped with the package
if [ -f "$YNH_APP_BASEDIR/doc/archiveteam-warrior.png" ]; then
    cp "$YNH_APP_BASEDIR/doc/archiveteam-warrior.png" "/usr/share/yunohost/applogos/$app.png"
    yunohost user permission update "$app.main" --logo "/usr/share/yunohost/applogos/$app.png" || true
fi

ynh_script_progression "Pulling new Warrior image and recreating container..."
docker compose -f "$install_dir/docker-compose.yml" pull
systemctl daemon-reload
systemctl restart "$app"

ynh_script_progression "Warrior upgrade complete."

#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source _common.sh
source /usr/share/yunohost/helpers

#=================================================
# STOP THE WARRIOR CONTAINER
#=================================================

ynh_script_progression "Stopping Warrior container..."
if [ -f "$install_dir/docker-compose.yml" ]; then
    docker compose -f "$install_dir/docker-compose.yml" down --remove-orphans || true
fi
docker rm -f "$app" 2>/dev/null || true

#=================================================
# REMOVE SYSTEM CONFIGURATION
#=================================================

ynh_script_progression "Removing nginx and systemd unit..."
ynh_config_remove_nginx
ynh_config_remove_systemd
systemctl daemon-reload
ynh_safe_rm "/usr/share/yunohost/applogos/$app.png"

#=================================================
# REMOVE THE COMPOSE CONFIG
#=================================================

ynh_safe_rm "$install_dir/docker-compose.yml"
# /data holds unfinished WARCs; unfinished tracker items simply expire and

#=================================================
# END OF SCRIPT
#=================================================

# are re-queued by the tracker, so removing the app dir is safe.

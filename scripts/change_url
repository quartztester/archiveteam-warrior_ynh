#!/bin/bash
source /usr/share/yunohost/helpers


if [ "$path" != "/" ]; then
    ynh_die --message="The Warrior dashboard uses absolute URLs and only works at the root of a domain (path must be '/')."
fi

ynh_script_progression "Moving $app from $old_domain$old_path to $domain$path..."

# Drop the nginx snippet from the OLD vhost (settings still hold old values;
# the 'domain' env var here is the NEW one).
ynh_safe_rm "/etc/nginx/conf.d/$old_domain.d/$app.conf"
rmdir "/etc/nginx/conf.d/$old_domain.d" 2>/dev/null || true

ynh_app_setting_set --key=domain --value="$domain"
ynh_app_setting_set --key=path --value="$path"

# Re-render into the NEW vhost (also reloads nginx). The container itself is
# loopback-only on a fixed port, so nothing to restart there.
ynh_config_add_nginx

ynh_script_progression "Done. The tile moves to https://$domain$path (SSO-gated)."

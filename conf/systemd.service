[Unit]
Description=ArchiveTeam Warrior (app: __APP__)
Documentation=https://wiki.archiveteam.org/index.php/ArchiveTeam_Warrior
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__INSTALL_DIR__
# ynh's post-restore permission pass reverts script chowns to root; the
# container image hardcodes uid 1000 and crashloops without writable dirs
ExecStartPre=/bin/chown -R 1000:1000 __INSTALL_DIR__/data __INSTALL_DIR__/projects
ExecStartPre=/bin/chmod 755 __INSTALL_DIR__/data __INSTALL_DIR__/projects
ExecStart=/usr/bin/docker compose up -d --quiet-pull
# CI counts journal WARNINGs: compose pull progress lands there and trips
# the "shitload of warnings" gate; the dashboard is not a unit-log source
StandardOutput=null
StandardError=null
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300


# no User= on purpose: the unit only drives the docker socket as root; the container drops privileges itself.
 NoNewPrivileges=yes
 PrivateTmp=yes
 ProtectSystem=full
 ProtectControlGroups=yes
 ProtectKernelTunables=yes
 ProtectHome=yes
RestrictRealtime=yes
LockPersonality=yes
 SystemCallArchitectures=native
 CapabilityBoundingSet=~CAP_SYS_BOOT CAP_SYS_MODULE CAP_SYS_PACCT

 # @privileged left out of the deny-list: it contains chown, which ExecStartPre needs
 SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @setuid @swap @cpu-emulation
[Install]
WantedBy=multi-user.target

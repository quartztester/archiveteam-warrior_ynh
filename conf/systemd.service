[Unit]
Description=ArchiveTeam Warrior (app: __APP__)
Documentation=https://wiki.archiveteam.org/index.php/ArchiveTeam_Warrior
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__INSTALL_DIR__
ExecStart=/usr/bin/docker compose up -d --quiet-pull
# CI counts journal WARNINGs: compose pull progress lands there and trips
# the "shitload of warnings" gate; the dashboard is not a unit-log source
StandardOutput=null
StandardError=null
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=300


### Sandboxing baseline for a docker-CLI wrapper unit.
### NB: no User= here on purpose — this unit only talks to the docker socket,
### which YunoHost admins reach as root/docker-group; running the CLI as the
### unprivileged app user would break container management. The container
### itself drops privileges internally.
 NoNewPrivileges=yes
 PrivateTmp=yes
 ProtectSystem=full
 ProtectControlGroups=yes
 ProtectKernelTunables=yes
 ProtectHome=yes
RestrictRealtime=yes
LockPersonality=yes
 SystemCallArchitectures=native
 CapabilityBoundingSet=~CAP_SYS_BOOT CAP_SYS_MODULE CAP_SYS_PACCT

 SystemCallFilter=~@clock @debug @module @mount @obsolete @reboot @setuid @swap @cpu-emulation @privileged
[Install]
WantedBy=multi-user.target
